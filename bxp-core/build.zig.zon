.{
    .name = .bxp_core,
    .fingerprint = 0xd3c3e96b8303f761,
    .version = "0.2.3",
    .dependencies = .{
        // Vendored locally under ./sunrise/ because upstream's
        // parseWithFormat hardcodes std.heap.page_allocator for its
        // FormatToken list, which translates to one mmap+munmap pair per
        // per-row DATE_CONVERT call. See ./sunrise/src/sunrise/parse.zig
        // for the patch note. Revert to the URL dep once the upstream
        // picks up the fix.
        .sunrise = .{ .path = "sunrise" },
    },
    .minimum_zig_version = "0.15.0",
    .paths = .{"."},
}
