.{
    .name = .bxp_core,
    .fingerprint = 0xd3c3e96b8303f761,
    .version = "0.2.4",
    // uucode (MIT) supplies the Unicode case-mapping / decomposition tables
    // behind UPPER/LOWER (full Unicode incl. ß→SS) and the upcoming `unaccent`.
    // Pinned to the `zig-0.15` back-port branch (its main line requires Zig
    // 0.16); revisit the pin on the Zig 0.16 migration. Field-selected in
    // build.zig so only the tables we use compile in. Date parsing/formatting
    // still lives in the in-house src/datefmt.zig (no dep).
    .dependencies = .{
        .uucode = .{
            .url = "https://github.com/jacobsandlund/uucode/archive/5dd92981eb5d9d65ae046201f4b4395569ed2790.tar.gz",
            .hash = "uucode-0.2.0-ZZjBPui3VAC_VVwydn3Tbi0Z03zbn4J8o0-_2SZWkmAS",
        },
    },
    .minimum_zig_version = "0.15.0",
    .paths = .{"."},
}
