.{
    .name = .bxp_core,
    .fingerprint = 0xd3c3e96b8303f761,
    .version = "0.3.0",
    // uucode (MIT) supplies the Unicode case-mapping / decomposition tables
    // behind UPPER/LOWER (full Unicode incl. ß→SS) and UNACCENT, which selects
    // three further fields (decomposition mapping + type, combining class).
    // Pinned to uucode main (Zig 0.16+); the former `zig-0.15` back-port
    // branch carried the 0.15.x line. Field-selected in
    // build.zig so only the tables we use compile in.
    .dependencies = .{
        .uucode = .{
            .url = "https://github.com/jacobsandlund/uucode/archive/2826a37a4562284fdacd8fa029d49509cc9bffcd.tar.gz",
            .hash = "uucode-0.2.0-ZZjBPlK5VADj7fdoq7G8LIHzD5o6FSkcBXXrRWr4jnrA",
        },
        // quangd/regex.zig (Apache-2.0 OR MIT) — the Pike-VM regular-expression
        // engine behind expr.zig's REGEX_MATCH / REGEX_EXTRACT. Pinned to an exact
        // commit (content-addressed by hash); chosen by the 2026-06-17 security +
        // capability audit for its zero transitive deps, OS-surface-free source,
        // and guaranteed linear-time (ReDoS-proof) matching. Re-audit the diff on
        // any pin bump.
        .regex = .{
            .url = "https://github.com/quangd42/regex.zig/archive/a22a2e68bcc5aa55310f12128de38e26bfa2cece.tar.gz",
            .hash = "regex-0.1.0-V8KKSWICBACgjPoyQLIoPwMnQjKzCpEOjUMEzkf3ebOD",
        },
        // zig-libs (MIT) — the module collection that now carries the hardened
        // descendants of several bxp-core modules. Bumping this pin moves TWELVE
        // modules at once: `tz`, `datefmt`, `encoding`, `json5`, `decimal`,
        // `zipstream`, `diagnostics`, `numparse`, `csvstream`, `minisign`,
        // `procrun` and `mcp` — that is the whole primitive layer plus the
        // bxp-mcp transport, so read the diff accordingly. All twelve come from
        // ONE b.dependency handle in build.zig, so `tz`'s own datefmt import
        // resolves to the same module rather than a second date core. The
        // per-module inventory and rationale live in bxp-core/CLAUDE.md ->
        // External dependencies. Treated as a foreign upstream: read-only,
        // pinned to an exact commit, never edited from this repo. Normally
        // that commit is the one behind a release tag (upstream tags by date,
        // `YYYY-MM-DD`); this pin is deliberately AHEAD of the newest one.
        // Tag `2026-09-02` leaves all twelve modules byte-identical to the
        // `2026-08-24` they were pinned at, because upstream's drift re-audits
        // of `json5`, `csvstream`, `encoding`, `procrun` and `mcp` landed
        // after it was cut — and four of those fix defects on paths bxp calls
        // (see CHANGELOG.md in each module). `zig fetch` cannot
        // target a subdirectory (ziglang/zig#23012)
        // so the whole collection is one package — only the modules actually
        // imported get compiled in.
        .zig_libs = .{
            .url = "git+https://github.com/zaxified/zig-libs.git#549e89917e054eb460ad8e801156aef3d8af413d",
            .hash = "zig_libs-0.0.0-WiQ0GkPB0APo1OI5fmPhLUXCmAeWISyTsBV_EjLuBK0z",
        },
    },
    .minimum_zig_version = "0.16.0",
    .paths = .{"."},
}
