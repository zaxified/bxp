{
  // The literal-only twin of full.json: same 1M-row input, same output bytes,
  // no regex engine. It leans on the fact that the generated memos always
  // anchor their tokens with the literals "INV-" and "#", which the free-text
  // teaching slice deliberately does NOT guarantee — that is the whole point of
  // the comparison on the page. Reaching for the cheap tools is right when the
  // anchors are stable, and impossible when they are not.
  //
  //   bash make-full.sh
  //   bxp-cli --config full.json
  //   bxp-cli --config full-cheap.json
  //   diff full/memos.csvx full/memos-cheap.csvx && echo identical
  conversion_templates: {
    freeform_payment_memos_cheap: {
      data_dir:           "full",
      file_pattern_in:    ".csv",
      file_pattern_out:   "-cheap.csvx",

      input_schema: {
        $txn_id: "[TxnId]",

        // Split on the literal anchor, then on the following space. Two scans
        // instead of one pattern-engine pass.
        $invoice: "IF(CONTAINS([Memo], 'INV-'), SPLIT_PART(SPLIT_PART([Memo], 'INV-', 2), ' ', 1), '')",
        $order:   "IF(CONTAINS([Memo], '#'),    SPLIT_PART(SPLIT_PART([Memo], '#', 2), ' ', 1), '')",

        // REGEX_MATCH returns the strings "true"/"false"; match that exactly.
        $has_ref:  "IF(CONTAINS([Memo], 'INV-') OR CONTAINS([Memo], '#'), 'true', 'false')",
        $priority: "SPLIT_PART([Tags], '|', 1)"
      },

      row_rules: [ { when: "1 = 1", rows: [ {} ] } ],

      output_schema: {
        txn_id:    "$txn_id",
        invoice:   "$invoice",
        order_ref: "$order",
        has_ref:   "$has_ref",
        priority:  "$priority"
      }
    }
  }
}
