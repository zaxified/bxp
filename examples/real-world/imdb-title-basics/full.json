{
  // Scale-run config: identical template to sample.json, but pointed at the
  // full title.basics.tsv fetched by fetch-full.sh into ./full/ (~12.5M rows).
  // Keep the input_schema in sync with sample.json — same dataset, same tricks.
  conversion_templates: {
    imdb_titles_to_catalog: {
      data_dir:           "full",
      file_pattern_in:    ".tsv",
      file_pattern_out:   ".csvx",
      // TRICK 0 — IMDb publishes title.basics as TSV, not CSV.
      csv_delimiter_in:   "\t",
      // TRICK 0b — TSV is unquoted but titles contain literal `"`; disable
      // input quoting or RFC-4180 quote-merging silently drops ~256k rows.
      // See sample.json for the full story.
      csv_text_quote_in:  "none",
      csv_delimiter_out:  ",",
      csv_text_quote_out: "double",

      input_schema: {
        $id:    "[tconst]",
        $type:  "[titleType]",
        $title: "[primaryTitle]",
        $orig:  "[originalTitle]",
        $adult: "IF([isAdult] = '1', 'true', 'false')",

        $year:    "IF([startYear]      = '\\N', '', [startYear])",
        $end:     "IF([endYear]        = '\\N', '', [endYear])",
        $runtime: "IF([runtimeMinutes] = '\\N', '', [runtimeMinutes])",

        $primary_genre: "IF([genres] = '\\N', '', SPLIT_PART([genres], ',', 1))",
        $all_genres:    "IF([genres] = '\\N', '', [genres])"
      },

      row_rules: [ { when: "1 = 1", rows: [ {} ] } ],

      output_schema: {
        id:            "$id",
        type:          "$type",
        title:         "$title",
        original:      "$orig",
        adult:         "$adult",
        year:          "$year",
        end_year:      "$end",
        runtime_min:   "$runtime",
        primary_genre: "$primary_genre",
        all_genres:    "$all_genres"
      }
    }
  }
}
