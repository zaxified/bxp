{
  // Scale/complete-run config: identical conversion to sample.json, pointed at
  // the full OpenNGC catalogue in ./full/ (~13,970 objects). Columns are
  // referenced by name, so the same template runs on the slice and the full
  // file unchanged.
  conversion_templates: {
    ngc_to_decimal_degrees: {
      data_dir:          "full",
      file_pattern_in:   ".csv",
      file_pattern_out:  ".csvx",
      csv_delimiter_in:  ";",
      csv_delimiter_out: ",",

      input_schema: {
        $name:    "[Name]",
        $ra_deg:  "IF(LEN(TRIM([RA])) = 0, '', (SPLIT_PART([RA], ':', 1) + SPLIT_PART([RA], ':', 2) / 60 + SPLIT_PART([RA], ':', 3) / 3600) * 15)",
        $dec_deg: "IF(LEN(TRIM([Dec])) = 0, '', IF(STARTS_WITH(TRIM([Dec]), '-'), -1, 1) * (ABS(SPLIT_PART([Dec], ':', 1)) + SPLIT_PART([Dec], ':', 2) / 60 + SPLIT_PART([Dec], ':', 3) / 3600))"
      },

      row_rules: [ { when: "1 = 1", rows: [ {} ] } ],

      output_schema: {
        name:    "$name",
        ra_deg:  "$ra_deg",
        dec_deg: "$dec_deg"
      }
    }
  }
}
