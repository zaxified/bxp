# Private data — never commit
DEV/

# Pre-restructure docs snapshot — local backup only
docs-old/

# MkDocs build output
site/

# Docs playground engine — a generated binary, rebuilt by
# scripts/gen-wasm-playground.sh (which scripts/gen-docs.sh calls). Tracking a
# 766 KiB artifact that any checkout can regenerate would bloat the history for
# nothing.
docs/assets/wasm/

# MkDocs Material plugin cache (social cards / git dates) — build-time only
.cache/

# Local docs toolchain virtualenv (build-time only)
.venv-docs/

# Binary release artifacts → GitHub Releases
releases/
*.tar.gz
*.zip
# …but the small committed example input slices are kept (the full pulls, e.g.
# full*.zip, stay ignored by the rule above + the full/ rule below).
!docs/examples/**/sample.zip

# Claude local state
.claude/

# codedb MCP index snapshot (local code-intelligence cache)
codedb.snapshot

# Zig 0.16 project-local package dir: 0.16 still uses the global
# ~/.cache/zig, but additionally materializes resolved deps into ./zig-pkg/.
# Disposable (re-extracted on build); 0.15.2 never creates it.
zig-pkg/

# OS artifacts
.DS_Store
Thumbs.db
*.swp
scripts/bench/work/

# Bench run outputs are regenerated artifacts — don't track new ones, or
# scripts/bench/results/ grows unbounded one CSV per run. A handful of
# baselines stay tracked (negated below) because PROGRESS.md /
# COMPARISON-ndjson-vs-bin.md cite them by filename.
scripts/bench/results/results-*.csv
!scripts/bench/results/results-20260522-010048.csv
!scripts/bench/results/results-20260524-024521.csv
!scripts/bench/results/results-20260602-064320.csv
!scripts/bench/results/results-20260604-005730.csv
!scripts/bench/results/results-20260604-071536.csv
!scripts/bench/results/results-20260615-101532.csv
!scripts/bench/results/results-20260701-123102.csv

# Full real-world datasets fetched on demand by docs/examples/*/fetch-full.sh
# (hundreds of MB — never committed; the small sample.* slices are enough
# for the repo, the full pull is a local scale demonstration). Both forms are
# ignored: a plain directory, and the symlink-into-tmp that the RÚIAN script
# creates so its 6,258 unpacked members never land inside the workspace.
docs/examples/real-world/*/full/
docs/examples/real-world/*/full
# The advanced teaching tier has one scale input too — generated, not fetched
# (advanced/freeform-payment-memos/make-full.sh), same ./full/ layout.
docs/examples/advanced/*/full/

# Python bytecode from the docs/test helper scripts.
__pycache__/
