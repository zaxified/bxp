    // ── XTB (old format, cash operations) → Wealthfolio ──
    //   Pattern: centralized cash branching in input_schema. Stock vs cash
    //   rows are distinguished by [Symbol] != ''; cash rows get the
    //   $CASH-CZK placeholder. A few row_rules entries override $variables
    //   for special cases (Stock purchase parses qty/price out of the
    //   Comment field via SPLIT_PART).
    xtb1_cash_to_wealthfolio: {
      description:         "XTB cash operations, old export -> Wealthfolio",
      data_dir:            "xtb1_to_wealthfolio",  // same dir as xtb1_closed; xlsx extracted once
      xlsx_sheet: {
        name:           "CASH OPERATION",
        header_row:     11,  // rows 1–10 are title/metadata rows
        output_suffix:  "_cash.csv"
      },
      file_type_in:        "csv",
      file_type_out:       "csv",
      file_pattern_in:     "_cash.csv",
      file_pattern_out:    "_cash.csvx",
      csv_delimiter_in:    ",",
      csv_delimiter_out:   ",",
      csv_decimal_separator_in: ".",
      csv_decimal_separator_out: ".",
      csv_text_quote_in:   "double",
      csv_text_quote_out:  "double",
      date_filter_from_filename: false,
      input_schema: {
        $date:            "[Time]",
        // cash rows without symbol → cash placeholder; stock rows → mapped ticker
        $ticker:          "IF([Symbol] != '', REPLACE(REMAP([Symbol],'xtb'), '.US','', '.NL','.AS', '.UK','.L', '.CH','.SW', '.CZ','.PR'), '$CASH-CZK')",
        $quantity:        "'1'",  // cash operations have no share quantity
        $unitprice:       "ABS([Amount])",
        $currency:        "'CZK'",
        $fee:             "",
        $amount:          "ABS([Amount])",
        $account:         "",
        $fxRate:          "",
        $subtype:         "",
        $instrumentType:  "",
        $comment:         "''' & [ID] & '_' & [Time] & '_' & [Comment] & '''"
      },
      row_rules_debug_missing: true,
      row_rules: [
        // note: typo in XTB export
        {
          when:  "[Type] = 'DIVIDENT'",
          rows: [
            {
              $action:  "'DIVIDEND'"
            }
          ]
        },
        {
          when:  "[Type] = 'Withholding Tax'",
          rows: [
            {
              $action:  "'TAX'"
            }
          ]
        },
        {
          when:  "[Type] = 'Stamp Duty'",
          rows: [
            {
              $action:  "'TAX'"
            }
          ]
        },
        {
          when:  "[Type] = 'Free-funds Interest'",
          rows: [
            {
              $action:  "'INTEREST'"
            }
          ]
        },
        {
          when:  "[Type] = 'Free-funds Interest Tax'",
          rows: [
            {
              $action:  "'TAX'"
            }
          ]
        },
        {
          when:  "[Type] = 'deposit'",
          rows: [
            {
              $action:  "'DEPOSIT'"
            }
          ]
        },
        {
          // Stock purchase: quantity and unit price extracted from Comment field
          // Comment format: "Buy TICKER QTY/PRICE ..." → SPLIT_PART parses position 3
          when:  "[Type] = 'Stock purchase'",
          rows: [
            {
              $action:     "'BUY'",
              $ticker:     "REPLACE(REMAP([Symbol],'xtb'), '.US','', '.NL','.AS', '.UK','.L', '.CH','.SW', '.CZ','.PR')",
              $quantity:   "SPLIT_PART(SPLIT_PART([Comment], ' ', 3), '/', 1)",
              $unitprice:  "ROUND(ABS([Amount]) / SPLIT_PART(SPLIT_PART([Comment], ' ', 3), '/', 1), 8)",
              $comment:    "''' & [ID] & '_' & [Time] & '_' & [Comment] & '''"
            }
          ]
        },
        {
          when:  "[Type] = 'Stock sale'",
          rows: []
        },
        // covered by xtb1_closed
        {
          when:  "[Type] = 'close trade'",
          rows: []
        },
        {
          when:  "[Type] = ''",
          rows: []
        }
      ],
      output_schema: {
        date:            "$date",
        symbol:          "$ticker",
        quantity:        "$quantity",
        activityType:    "$action",
        unitPrice:       "$unitprice",
        currency:        "$currency",
        fee:             "$fee",
        amount:          "$amount",
        account:         "$account",
        fxRate:          "$fxRate",
        subtype:         "$subtype",
        instrumentType:  "$instrumentType",
        comment:         "$comment"
      }
