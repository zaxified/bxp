              $action:  "'DIVIDEND'"
            }
          ]
        },
        {
          when:  "[Type] = 'Withholding tax'",
          rows: [
            {
              $action:  "'TAX'"
            }
          ]
        },
        {
          when:  "[Type] = 'Stamp duty'",
          rows: [
            {
              $action:  "'TAX'"
            }
          ]
        },
        {
          when:  "[Type] = 'Free funds interest'",
          rows: [
            {
              $action:  "'INTEREST'"
            }
          ]
        },
        {
          when:  "[Type] = 'Free funds interest tax'",
          rows: [
            {
              $action:  "'TAX'"
            }
          ]
        },
        {
          // same Comment parsing as xtb1; format unchanged in new XTB export
          when:  "[Type] = 'Stock purchase'",
          rows: [
            {
              $action:     "'BUY'",
              $ticker:     "TICKER([Ticker])",
              $quantity:   "SPLIT_PART(SPLIT_PART([Comment], ' ', 3), '/', 1)",
              $unitprice:  "ABS([Amount]) / SPLIT_PART(SPLIT_PART([Comment], ' ', 3), '/', 1)",
              $comment:    "''' & [ID] & '_' & [Time] & '_' & [Comment] & '''"
            }
          ]
        },
        {
          when:  "[Type] = 'Stock sell'",
          rows: []
        },
        // covered by xtb2_closed
        {
          when:  "[Type] = 'Stock sale'",
          rows: []
        },
        {
          when:  "[Type] = 'Deposit'",
          rows: [
