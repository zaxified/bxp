        $currency:        "'CZK'",
        $fee:             "",
        $amount:          "ABS([Amount])",
        $account:         "",
        $fxRate:          "",
        $subtype:         "",
        $instrumentType:  "",
        $comment:         "''' & [ID] & '_' & [Time] & '_' & [Comment] & '''"
      },
      row_rules_debug_missing: true,
      row_rules: [
        {
