    // ── XTB (new format from 2026-07-01, cash operations) → Wealthfolio ──
    xtb2_cash_to_wealthfolio: {
      data_dir:            "xtb2_to_wealthfolio",  // same dir as xtb2_closed; xlsx extracted once
      xlsx_sheet: {
        name:           "Cash Operations",  // new format sheet name
        header_row:     5,
        output_suffix:  "_cash.csv"
      },
      file_type_in:        "csv",
      file_type_out:       "csv",
      file_pattern_in:     "_cash.csv",
      file_pattern_out:    "_cash.csvx",
      csv_delimiter_in:    ",",
