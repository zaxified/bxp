            {
              $action:  "'SELL'"
            }
          ]
        },
        // P/L summary rows
        {
          when:  "[Instrument] = 'Profit/loss'",
          rows: []
        }
      ],
      output_schema: {
        date:            "$date",
        symbol:          "$ticker",
        quantity:        "$quantity",
        activityType:    "$action",
        unitPrice:       "$unitprice",
        currency:        "$currency",
        fee:             "$fee",
        amount:          "$amount",
