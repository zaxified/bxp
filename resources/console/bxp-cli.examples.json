        $fee:             "",
        $amount:          "[Sale Value]",
        $account:         "",
        $fxRate:          "",
        $subtype:         "",
        $instrumentType:  "",
        $comment:         "''' & [Position ID] & '_' & [Open Time (UTC)] & '''"
      },
      row_rules_debug_missing: true,
      row_rules: [
        {
          when:  "[Type] = 'BUY'",
