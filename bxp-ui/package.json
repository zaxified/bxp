{
	"name": "bxp-ui",
	"version": "0.1.0",
	"description": "Electrobun UI for bxp-cli: JSON5 config editor + dry-run debugger",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "bash scripts/sync-dev-bins.sh; concurrently --kill-others --kill-signal=SIGINT --success=first \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build": "bash scripts/stage-bins.sh && vite build && electrobun build",
		"build:canary": "bash scripts/stage-bins.sh && vite build && electrobun build --env=canary",
		"stage-bins": "bash scripts/stage-bins.sh"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.18.3",
		"@codemirror/commands": "^6.7.1",
		"@codemirror/language": "^6.10.5",
		"@codemirror/lint": "^6.8.4",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.35.0",
		"@croct/json5-parser": "^0.2.2",
		"@lezer/highlight": "^1.2.1",
		"electrobun": "1.17.3-beta.11",
		"json5": "^2.2.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
