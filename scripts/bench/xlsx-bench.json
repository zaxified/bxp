{
  // Profiling config for the synthetic xlsx generated by gen-xlsx.py.
  // The DATA sheet (header row 1, cols Date/Symbol/Type/Volume/Sale value)
  // is converted to an intermediate <stem>_data.csv, then processed.
  conversion_templates: {
    xlsx_bench: {
      data_dir:            ".",
      xlsx_sheet: {
        name:           "DATA",
        header_row:     1,
        output_suffix:  "_data.csv"
      },
      file_type_in:        "csv",
      file_type_out:       "csv",
      file_pattern_in:     "_data.csv",
      file_pattern_out:    "_data.csvx",
      csv_delimiter_in:    ",",
      csv_delimiter_out:   ",",
      csv_text_quote_in:   "none",
      csv_text_quote_out:  "double",
      date_filter_from_filename: false,
      input_schema: {
        $date:            "[Date]",
        $ticker:          "[Symbol]",
        $quantity:        "[Volume]",
        $unitprice:       "[Sale value] / [Volume]",
        $currency:        "'USD'",
        $amount:          "[Sale value]"
      },
      row_rules: [
        {
          when:  "[Type] = 'BUY'",
          rows: [ { $action: "'BUY'" } ]
        },
        {
          when:  "[Type] = 'SELL'",
          rows: [ { $action: "'SELL'" } ]
        }
      ],
      output_schema: {
        date:          "$date",
        symbol:        "$ticker",
        quantity:      "$quantity",
        activityType:  "$action",
        unitPrice:     "$unitprice",
        currency:      "$currency",
        amount:        "$amount"
      }
    }
  }
}
