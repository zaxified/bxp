{
  ticker_maps: {
    xtb: {
      "ASML.NL":   "ASML.AS",
      "BNTX.US":   "BNTX",
      "BP.UK":     "BP.L",
      "CSG.NL":    "CSG.AS",
      "CZG.CZ":    "CZG.PR",
      "FOUR.US":   "FOUR",
      "KOMB.CZ":   "KOMB.PR",
      "MRNA.US":   "MRNA",
      "NESN.CH":   "NESN.SW",
      "NOVN.CH":   "NOVN.SW",
      "O.US":      "O",
      "PFE.US":    "PFE",
      "ROG.CH":    "ROG.SW",
      "TABAK.CZ":  "TABAK.PR",
      "VICI.US":   "VICI",
      "VWRA.UK":   "VWRA.L"
    }
  },
  conversion_templates: {
    xtb2_closed_to_wealthfolio: {
      data_dir:            ".",
      xlsx_sheet: {
        name:           "Closed Positions",
        header_row:     5,
        output_suffix:  "_closed.csv"
      },
      file_type_in:        "csv",
      file_type_out:       "csv",
      file_pattern_in:     "_closed.csv",
      file_pattern_out:    "_closed.csvx",
      csv_delimiter_in:    ",",
      csv_delimiter_out:   ",",
      csv_decimal_separator_in: ".",
      csv_decimal_separator_out: ".",
      csv_text_quote_in:   "none",
      csv_text_quote_out:  "double",
      date_filter_from_filename: false,
      ticker_map:          "xtb",
      input_schema: {
        $date:            "[Close Time (UTC)]",
        $ticker:          "TICKER([Ticker])",
        $quantity:        "[Volume]",
        $unitprice:       "[Sale Value] / [Volume]",
        $currency:        "'CZK'",
        $fee:             "",
        $amount:          "[Sale Value]",
        $account:         "",
        $fxRate:          "",
        $subtype:         "",
        $instrumentType:  "",
        $comment:         "''' & [Position ID] & '_' & [Open Time (UTC)] & '''"
      },
      row_rules_debug_missing: true,
      row_rules: [
        {
          when:  "[Type] = 'BUY'",
          rows: [
            {
              $action:  "'SELL'"
            }
          ]
        },
        {
          when:  "[Instrument] = 'Profit/loss'",
          rows: []
        }
      ],
      output_schema: {
        date:            "$date",
        symbol:          "$ticker",
        quantity:        "$quantity",
        activityType:    "$action",
        unitPrice:       "$unitprice",
        currency:        "$currency",
        fee:             "$fee",
        amount:          "$amount",
        account:         "$account",
        fxRate:          "$fxRate",
        subtype:         "$subtype",
        instrumentType:  "$instrumentType",
        comment:         "$comment"
      }
    }
  }
}
