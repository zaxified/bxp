// markdownlint-cli2 config — also read by the VS Code DavidAnson extension.
// Tailored to the bxp project's actual writing style; rules left at default
// unless we have a concrete reason to relax them.
{
  "config": {
    // MD013 (line-length): prose docs are written for readers, not 80-col
    // terminals. resources/desktop/readme.md is ~1000 lines of user-facing
    // tutorial where strict 80-char wrap would hurt readability without
    // serving any purpose. Defer line length to editorial judgement.
    "MD013": false,

    // MD024 (duplicate headings): a CHANGELOG legitimately repeats
    // `### Features` / `### Fixes` under each `## vX.Y.Z` section.
    // `siblings_only` permits this — only flags duplicates at the same
    // nesting level under the same parent.
    "MD024": {
      "siblings_only": true,
    },

    // MD033 (no inline HTML): block by default but allow the two tags
    // that power GitHub-style collapsible sections (`<details>` /
    // `<summary>`). README.md uses these for spoilered "show all
    // conversion templates" blocks; the alternative would lose that UX.
    "MD033": {
      "allowed_elements": ["details", "summary"],
    },
  },
  "ignores": [
    "**/node_modules/**",
    "**/build/**",
    "**/.dart_tool/**",
    "**/.zig-cache/**",
    "**/zig-cache/**",
    "**/zig-out/**",
    "**/DEV/**",
    "**/ephemeral/**",
    "scripts/bench/work/**",
    "**/.plugin_symlinks/**",
    "LICENSE.md",
    // CLAUDE.md files are agent-facing guidance with dense tables + manual
    // column alignment; markdownlint's table/emphasis rules fight that style
    // and they are never rendered for end users. Exempt all of them.
    "**/CLAUDE.md",
  ],
}
